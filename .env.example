# =========================
# FirstRound configuration
# =========================

# LLM_PROVIDER: groq | anthropic | mock
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# GitHub grounding. Optional for public repos; recommended to raise API limits.
GITHUB_TOKEN=

# =========================
# Realtime interview
# =========================
# console = local text-mode development/test double
# livekit = LiveKit Cloud transport (recommended stack)
# daily   = legacy Daily.co transport, kept for reference
REALTIME_MODE=console
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Native WebRTC diagnostics. Enable only while collecting ICE/DTLS logs.
LIVEKIT_RTC_DEBUG=false
# One peer connection avoids the legacy separate Subscriber-PC path.
LIVEKIT_SINGLE_PEER_CONNECTION=true
LIVEKIT_CONNECT_TIMEOUT_S=15
LIVEKIT_CANDIDATE_WAIT_TIMEOUT_S=300
# all = normal ICE; relay = TURN-only diagnostic; nohost = omit host candidates
LIVEKIT_ICE_TRANSPORT=all
# false is an isolation mode; remote audio is then subscribed explicitly.
LIVEKIT_AUTO_SUBSCRIBE=true
DAILY_API_KEY=

# AI face: simli = real lip-synced avatar (needs SIMLI_API_KEY + a face,
# recommended stack); 2d = local viseme-swap portrait, zero external dep,
# also the automatic fallback if Simli errors mid-call.
AVATAR_PROVIDER=simli
SIMLI_API_KEY=
SIMLI_FACE_ID=

# TTS: edge-tts is the default free option; elevenlabs is optional.
TTS_PROVIDER=edge-tts
ELEVENLABS_API_KEY=

# =========================
# Persistence / behaviour
# =========================
SQLITE_PATH=output/checkpoints.sqlite
MAX_FOLLOW_UP_PROBES=2
BARGE_IN_ENABLED=true
CANDIDATE_SILENCE_TIMEOUT_S=15
MAX_ANSWER_DURATION_S=120
